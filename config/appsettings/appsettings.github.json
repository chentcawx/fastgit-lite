{
  "FastGithub": {
    "DomainConfigs": {
      "github.com": {
        "TlsSni": false
      },
      "api.github.com": {
        "TlsSni": false
      },
      "githubstatus.com": {
        "TlsSni": false
      },
      "gist.github.com": {
        "TlsSni": false,
        "TlsIgnoreNameMismatch": true
      },
      "vscode-auth.github.com": {
        "TlsSni": true
      },
      "*.github.com": {
        "TlsIgnoreNameMismatch": true
      },
      "*.github.io": {
        "TlsIgnoreNameMismatch": true
      },
      "*.githubapp.com": {
        "TlsSni": false,
        "TlsIgnoreNameMismatch": true
      },
      // 实测：本网络对 github 系任意 SNI 都会 RST（含 CDN），故全系显式省略 SNI。
      // 静态资源偶发加载失败是上游 IP 可达性问题，由 mitm_forward 的换 IP 重试解决。
      "*.githubassets.com": {
        "TlsSni": false,
        "TlsIgnoreNameMismatch": true
      },
      "*.githubusercontent.com": {
        "TlsSni": false,
        "TlsIgnoreNameMismatch": true
      }
    }
  }
}