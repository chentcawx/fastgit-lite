{
  // 与原项目 appsettings.json 保持兼容；新增的 Silent 段为 Rust 版独有配置
  // 新增/删除 appsettings.*.json 子配置文件后需重启（热加载仅覆盖已加载文件）
  "FastGithub": {
    "HttpProxyPort": 38457, // http 正向代理端口（同时作为 UDP 日志端口默认值）
    "FallbackDns": [ // 回退 DNS，端口 53 走 TCP 查询
      "8.8.8.8:53",
      "119.29.29.29:53",
      "114.114.114.114:53"
    ],
    "DomainConfigs": {
      "*.fastgithub.com": { // 域名的 * 表示除 . 之外 0 到多个任意字符
        "TlsSni": false, // 指示 tls 握手时是否发送 SNI
        "TlsSniPattern": null, // @domain / @ipaddress / @random 变量
        "TlsIgnoreNameMismatch": false, // 是否忽略上游证书域名不匹配（见兼容性文档）
        "Timeout": null, // 请求超时时长，格式 "00:02:00"
        "IPAddress": null, // 强制使用的上游 IP
        "Destination": null, // 请求目的地，绝对或相对 Uri
        "Response": { // 阻断请求并直接响应
          "StatusCode": 404,
          "ContentType": "text/plain;charset=utf-8",
          "ContentValue": "这是一个用于示范配置的域名"
        }
      }
    },
    // ---- Rust 版静默后台运行配置（原 .NET 版忽略此段）----
    "Silent": {
      "Mode": "mitm", // mitm = 完整 TLS 终止（需先运行 scripts\install-ca.ps1 安装一次自签 CA）；proxy = 字节级透传，绝不改写 ClientHello
      "LogLevel": "Information", // Debug / Information / Warning / Error
      "LogToFile": true, // logs/log-YYYY-MM-DD.txt，绝不输出到控制台
      "UdpLog": true, // 向 127.0.0.1:<UdpLoggerPort> 发送 JSON 日志
      "SingleInstance": true, // Global\FastGithub 互斥
      "WatchConfig": true, // 2 秒轮询配置文件变更并热加载
      "PacEnabled": true, // http://127.0.0.1:38457/proxy.pac
      "ProxyBind": "127.0.0.1", // 正向代理监听地址；仅本机用 127.0.0.1，共享给局域网改为 0.0.0.0（PAC 会自动回显客户端所连的 LAN IP）
      "FlowStatistics": true, // http://127.0.0.1:38457/flowStatistics
      "AdBlock": {
        "Enabled": true, // 广告过滤总开关；域名清单在 config\ad-domains.txt，保存后 2 秒热加载
        "StatusCode": 200 // 命中时返回的状态码，200 + 空内容对图片/脚本最兼容（可改 204 / 404）
      },
      "DnsEnabled": true, // 本地 DNS 解析：命中域名返回 127.0.0.1 / ::1
      "DnsBind": "127.0.0.1:53",
      "HttpsListener": true, // 监听 127.0.0.1:443 做 TLS 透传
      "HttpListener": true, // 监听 127.0.0.1:80 做 HTTP 反向代理
      "SshProxy": true, // github.com:22
      "GitProxy": true, // github.com:9418
      "ConnectTimeoutSecs": 10,
      "SpeedTestIntervalSecs": 1,
      "Mitm": {
        "Enabled": true,
        "CaDir": "cacert", // 本地 CA 与叶证书缓存目录（相对 exe）
        "InstallCa": false, // 程序绝不自动安装 CA；由 scripts\install-ca.ps1 显式一次性完成
        "ConfigureGit": false, // 绝不自动执行 git config
        "ServerNameInSan": true
      }
    }
  },
  "AppOptions": {
    "ParentProcessId": 0, // >0 时父进程退出即自动停机
    "UdpLoggerPort": 38457
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Yarp": "Warning",
        "System": "Warning",
        "Microsoft": "Warning"
      }
    }
  }
}
