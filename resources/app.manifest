<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<assembly xmlns="urn:schemas-microsoft-com:asm.v1" manifestVersion="1.0">
  <!--
    Silent-background manifest for the Rust rewrite.
    Differs from the original FastGithub/app.manifest on purpose:

      original : <requestedExecutionLevel level="requireAdministrator" />
      rewrite  : <requestedExecutionLevel level="asInvoker" />

    requireAdministrator triggers a UAC consent dialog at every launch, which
    violates the "no popup / no interaction" requirement. The Rust build needs
    no elevation: it binds loopback ports, never installs a kernel driver,
    never writes hosts / registry / root certificate store.

    This file is embedded by build.rs through /MANIFESTINPUT on MSVC targets.
  -->
  <assemblyIdentity version="2.1.5.0" name="FastGithub" type="win32" processorArchitecture="x86"/>
  <trustInfo xmlns="urn:schemas-microsoft-com:asm.v2">
    <security>
      <requestedPrivileges xmlns="urn:schemas-microsoft-com:asm.v3">
        <requestedExecutionLevel level="asInvoker" uiAccess="false"/>
      </requestedPrivileges>
    </security>
  </trustInfo>
  <compatibility xmlns="urn:schemas-microsoft-com:compatibility.v1">
    <application>
      <!-- Windows 10 / Windows 11 -->
      <supportedOS Id="{8e0f7a12-bfb3-4fe8-b9a5-48fd50a15a9a}"/>
    </application>
  </compatibility>
  <application xmlns="urn:schemas-microsoft-com:asm.v3">
    <windowsSettings>
      <dpiAware xmlns="http://schemas.microsoft.com/SMI/2005/WindowsSettings">true</dpiAware>
      <longPathAware xmlns="http://schemas.microsoft.com/SMI/2016/WindowsSettings">true</longPathAware>
    </windowsSettings>
  </application>
</assembly>
