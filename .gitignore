# Build output / staged runtime bundle
/target/
/dist/

# Local CA material — NEVER commit. The private key is machine-local and
# regenerated by fastgithub.exe on first run; distributing it would let anyone
# impersonate every HTTPS site for clients that trusted this CA.
*.key
*.pem
*.cer
cacert/

